{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CINE WANA",
  "version": "0.1.5",
  "identifier": "com.cinewana.app",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "CINE WANA",
      "width": 1440,
      "height": 900,
      "minWidth": 1050,
      "minHeight": 680,
      "center": true,
      "decorations": true,
      "resizable": true,
      "backgroundColor": "#111111"
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost https://asset.localhost blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": ["$APPDATA/cache/**", "$HOME/**", "D:\\peliculas-y-series\\**"] }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "shortDescription": "Tu biblioteca privada de peliculas y series",
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["Spanish"] },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZBODI3ODA3QTUyM0VDQkEKUldTNjdDT2xCM2lDYXZzU043T1k0V04yalRqaEVKdHhHSTRJMlloc1RjWnU4MUlPbEYrUUpuTnAK",
      "endpoints": ["https://github.com/Lucasleiva1/cinewana/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
