{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CINE WANA",
  "version": "0.1.0",
  "identifier": "com.cinewana.app",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "CINE WANA",
      "width": 1440,
      "height": 900,
      "minWidth": 1050,
      "minHeight": 680,
      "center": true,
      "decorations": true,
      "resizable": true,
      "backgroundColor": "#111111"
    }],
    "security": { "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Tu biblioteca privada de películas y series",
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["Spanish"] }, "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true } }
  }
}
